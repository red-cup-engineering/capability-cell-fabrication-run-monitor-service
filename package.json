{
  "name": "@red-cup-engineering/capability-cell-fabrication-run-monitor-service",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Validates and folds one append-only Capability Cell fabrication event trajectory into its current observable state.",
  "exports": {
    ".": "./src/observe.mjs",
    "./a2a-executor": "./src/a2a-executor.mjs",
    "./law": "./src/law.mjs",
    "./schemas": "./src/schemas.mjs"
  },
  "bin": {
    "observe-capability-cell-fabrication-run": "./bin/observe.mjs",
    "execute-capability-cell-fabrication-run-observation-a2a-message": "./bin/execute-a2a-message.mjs",
    "serve-capability-cell-fabrication-run-observation-seller": "./bin/x402-server.mjs"
  },
  "scripts": {
    "check": "node --check src/schemas.mjs && node --check src/law.mjs && node --check src/observe.mjs && node --check src/a2a-executor.mjs && node --check bin/observe.mjs && node --check bin/execute-a2a-message.mjs && node --check bin/x402-server.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@emsenn/a2a-contracted-agent-service": "file:../../../web-services-section/services/a2a-services-section/services/a2a-contracted-agent-service",
    "@emsenn/a2a-rmn-part-service": "file:../../../web-services-section/services/a2a-services-section/services/a2a-rmn-part-service",
    "@emsenn/activitypub-services-section": "file:../../../web-services-section/services/activitypub-services-section",
    "@emsenn/rmn-semantic-conformance": "file:../../../../../lenticule-science/services/obsmetrological-services-section/services/rmn-semantic-conformance",
    "@emsenn/x402-services-section": "file:../../../web-services-section/services/x402-services-section",
    "express": "5.2.1"
  },
  "x-agentic-metro-enterprise": {
    "node-id": "capability-cell-fabrication-run-monitor-service",
    "actor": "urn:ame:capability-cell-fabrication-run-monitor-service",
    "organizational-kind": "sovereign-monitoring-cell",
    "owners": [
      "red-cup-engineering"
    ],
    "operation-catalog": {
      "observe-capability-cell-fabrication-run": {
        "inputSchema": "content/schemas/observation-input.schema.json",
        "outputSchema": "content/schemas/observation-output.schema.json",
        "refusalSchema": "content/schemas/observation-refusal.schema.json",
        "stateSchema": "content/schemas/observed-run-state.schema.json"
      }
    },
    "admission": "one ordered append-only fabrication event trajectory and its declared stage order",
    "refusal": "broken event identity, sequence, predecessor, run identity, unknown stage, or any request to analyze, plan, execute, or mutate"
  }
}
