{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:red-cup-engineering:schema:monitor-fabrication-run-cloud-event:v1",
  "title": "CloudEvents 1.0 structured JSON fabrication-run observation",
  "description": "Read-only standard envelope for an accepted source-bound Monitor result. Does not confer deployment, authority or payment status.",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" },
    "source": { "type": "string", "format": "uri" },
    "type": { "const": "group.561.capability-fabrication.run.observed.v1" },
    "subject": { "type": "string", "minLength": 1 },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "data": { "$ref": "urn:red-cup-engineering:schema:monitor-capability-cell-fabrication-run-observation-output:v2" }
  },
  "additionalProperties": false
}
