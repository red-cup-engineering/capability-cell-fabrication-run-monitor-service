{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:red-cup-engineering:schema:capability-cell-fabrication-run-observation-input:v1",
  "type": "object",
  "required": ["type", "run", "stages", "events"],
  "properties": {
    "type": { "const": "CapabilityCellFabricationRunObservationRequest" },
    "run": { "type": "string", "pattern": "^(?:[A-Za-z0-9_-]{43}|[0-9a-f-]{36})$" },
    "stages": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "run", "sequence", "at", "previous", "type"],
        "properties": {
          "id": { "type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{43}$" },
          "run": { "type": "string" },
          "sequence": { "type": "integer", "minimum": 0 },
          "at": { "type": "string" },
          "previous": { "type": ["string", "null"] },
          "type": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
